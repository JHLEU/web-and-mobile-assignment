<!DOCTYPE html>
<html lang="en">
<head>
    <title>@ViewBag.Title - CafeDash</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
    <script src="https://code.jquery.com/jquery-2.2.4.min.js"></script>
    <link rel="stylesheet" href="~/css/home-style.css">
    <script src="~/js/app.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
</head>
<body>
    <div class="sidebar">
        <h1 class="logo">Cafe Dash</h1>
        <div class="sidebar-menus">
            <a href="/Admin/Index"><ion-icon name="mail-outline"></ion-icon>Feedback</a>
            <a href="/Admin/Restaurants"><ion-icon name="restaurant-outline"></ion-icon>Restaurants</a>
            <a href="/Admin/Members"><ion-icon name="people-outline"></ion-icon>Members</a>
            <a href="/Admin/BatchManager"><ion-icon name="construct"></ion-icon>Batch Data Manager</a>
            <a href="/Admin/Ranking"><ion-icon name="trophy-outline"></ion-icon>Ranking</a>
            <a href="/Admin/LiveChat"><ion-icon name="chatbubbles-outline"></ion-icon>Live Chat</a>
            <a href="/Admin/Settings"><ion-icon name="settings-outline"></ion-icon>Setting</a>
        </div>

        <div class="sidebar-logout">
            <form method="POST" action="/Admin/Logout_btn" style="margin: 0;">
                <button type="submit" style="background: none; border: none; color: inherit; cursor: pointer; display: flex; align-items: center; gap: 10px; font-size: inherit; font-weight: inherit; padding: 0;">
                    <ion-icon name="log-out-outline"></ion-icon>
                    <span>Logout</span>
                </button>
            </form>
        </div>
    </div>
    @RenderBody()
</body>
</html>
