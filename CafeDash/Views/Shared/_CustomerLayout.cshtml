<!DOCTYPE html>
<html lang="en">
<head>
    <title>@ViewBag.Title - CafeDash</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/home-style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
</head>

<!-- This uses a safe fallback so the HTML never breaks if the class is empty -->
<body class="@(ViewBag.BodyClass ?? "")">

    <!-- SIDEBAR -->
    <div class="sidebar">
        <h1 class="logo">Cafe Dash</h1>
        <div class="sidebar-menus">
            <a href="/Home/Index"><ion-icon name="storefront-outline"></ion-icon>Home</a>
            <a href="/Home/Bills"><ion-icon name="receipt-outline"></ion-icon>Bills</a>
            <a href="/Home/Contact"><ion-icon name="chatbubbles-outline"></ion-icon>Contact Us</a>
            <a href="/Home/Settings"><ion-icon name="settings-outline"></ion-icon>Setting</a>
        </div>
        <div class="sidebar-logout">
            <!-- Updated to point to the correct Account Controller! -->
            <form action="/Account/Logout" method="POST" style="display: inline;">
                <button type="submit" style="background: none; border: none; color: inherit; font: inherit; cursor: pointer; padding: 0; display: flex; align-items: center; gap: 5px;">
                    <ion-icon name="log-out-outline"></ion-icon>Logout
                </button>
            </form>
        </div>
    </div>

    <!-- MAIN PAGE CONTENT INJECTED HERE -->
    @RenderBody()

    <!-- INJECT THE CART MODAL GLOBALLY -->
    <partial name="_CartModal" />

    <!-- Only draw the footer if the page hasn't hidden it -->
    @if (ViewBag.HideFooter != true)
    {
        <!-- FOOTER -->
        <footer class="footer">
            <div class="container">
                <div class="row" style="display: flex; justify-content: space-around; padding: 20px;">
                    <div class="col-md-6">
                        <h4>Contact Us</h4>
                        <p>Edumetro, Persiaran Subang Permai, Usj 1, 47500 Subang Jaya, Selangor</p>
                        <p>Email: CafeDash@gmail.com</p>
                        <p>Phone: 03-8600 1777</p>
                    </div>
                    <div class="col-md-6">
                        <h4>Follow Us</h4>
                        <p>Stay connected with us on social media:</p>
                        <ul class="social-icons" style="list-style: none; display: flex; gap: 15px; padding: 0;">
                            <li><a href="https://www.facebook.com/share/1BEvvsF4YG/?mibextid=wwXIfr"><i class="fab fa-facebook-f"></i></a></li>
                            <li><a href="https://x.com/CafeDash44362"><i class="fab fa-twitter"></i></a></li>
                            <li><a href="https://www.instagram.com/cafedashoffical?igsh=MXQxY204dDJ1eGpu&utm_source=qr"><i class="fab fa-instagram"></i></a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </footer>
    }

    <!-- SCRIPTS -->
    <script src="https://code.jquery.com/jquery-2.2.4.min.js"></script>
    <script src="~/js/app.js"></script>
</body>
</html>