@model CafeDash.Models.CheckoutViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <title>Payment Summary - CafeDash</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
    <link rel="stylesheet" href="~/css/home-style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
</head>
<body style="background-color: #f4f7f6;">

    <!-- THE CUSTOMER SIDEBAR -->
    <div class="sidebar">
        <h1 class="logo">Cafe Dash</h1>
        <div class="sidebar-menus">
            <a href="/Home/Index"><ion-icon name="home-outline"></ion-icon>Home</a>
            <a href="/Home/Bills"><ion-icon name="receipt-outline"></ion-icon>Bills</a>
            <a href="/Home/Contact"><ion-icon name="mail-outline"></ion-icon>Contact Us</a>
            <a href="/Home/Settings"><ion-icon name="settings-outline"></ion-icon>Settings</a>
        </div>
        <div class="sidebar-logout">
            <form action="/Account/Logout" method="POST" style="display: inline;">
                <button type="submit" style="background: none; border: none; color: inherit; font: inherit; cursor: pointer; padding: 0; display: flex; align-items: center; gap: 5px;">
                    <ion-icon name="log-out-outline"></ion-icon>Logout
                </button>
            </form>
        </div>
    </div>
    <!-- END SIDEBAR -->

    <div class="main">
        <div class="main-navbar">
            <a href="javascript:history.back()" class="cart"><ion-icon name="arrow-back-outline"></ion-icon></a>
            <div class="profile">
                <a class="cart" href="/Home/Index"><ion-icon name="home-outline"></ion-icon></a>
            </div>
        </div>

        <div class="main-menus">
            <div class="main-detail">
                <h2 class="main-title">Payment Summary</h2>

                @if (Model.Items.Count == 0)
                {
                    <p>Your cart is empty.</p>
                }
                else
                {
                    <table style="width:100%; border-collapse:collapse; margin-top:12px; background:#fff; border-radius:8px; overflow:hidden;">
                        <thead>
                            <tr style="background:#f2f2f2; text-align:left;">
                                <th style="padding:10px;">Item</th>
                                <th style="padding:10px;">Quantity</th>
                                <th style="padding:10px;">Unit Amount</th>
                                <th style="padding:10px;">Line Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td style="padding:10px; border-top:1px solid #eee;">@item.ItemName</td>
                                    <td style="padding:10px; border-top:1px solid #eee;">@item.Quantity</td>
                                    <td style="padding:10px; border-top:1px solid #eee;">RM @item.UnitAmount.ToString("0.00")</td>
                                    <td style="padding:10px; border-top:1px solid #eee;">RM @item.LineTotal.ToString("0.00")</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="payment-totals-card">
                        <div class="payment-totals-list">
                            <div class="payment-total-row">
                                <span class="payment-total-label">Total Amount</span>
                                <strong class="payment-total-value">RM @Model.Subtotal.ToString("0.00")</strong>
                            </div>
                            <div class="payment-total-row">
                                <span class="payment-total-label">SST (6%)</span>
                                <strong class="payment-total-value">RM @Model.Sst.ToString("0.00")</strong>
                            </div>
                            <div class="payment-total-row payment-total-row-grand">
                                <span class="payment-total-label">Total Amount + SST</span>
                                <strong class="payment-total-value">RM @Model.GrandTotal.ToString("0.00")</strong>
                            </div>
                        </div>
                    </div>

                    <div class="payment-card-section">
                        <label class="payment-card-label">Card Details</label>
                        <div class="payment-card-row">
                            <div class="payment-card-field">
                                <div id="card-element" class="payment-card-element"></div>
                            </div>
                        </div>
                        <div class="payment-card-actions">
                            <button type="button" class="search-btn payment-action-btn" id="pay-btn" style="width: 100%; padding: 15px; background: #007bff; color: white; border: none; border-radius: 5px; cursor: pointer;">
                                Pay Now — RM @Model.GrandTotal.ToString("0.00")
                            </button>
                        </div>
                        <div id="card-errors" class="payment-card-errors" style="color: #fa755a; margin-top: 10px;"></div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Scripts remain inline and active -->
    <script src="https://js.stripe.com/v3/"></script>
    <script>
            const stripe = Stripe('@Model.PublishableKey');
            const elements = stripe.elements({ locale: 'en' });
            const cardElement = elements.create('card', {
                hidePostalCode: true,
                disableLink: true,
                style: {
                    base: { fontSize: '16px', color: '#32325d', fontFamily: 'Arial, sans-serif', '::placeholder': { color: '#aab7c4' } },
                    invalid: { color: '#fa755a' }
                }
            });
            cardElement.mount('#card-element');

            cardElement.on('change', (event) => {
                document.getElementById('card-errors').textContent = event.error ? event.error.message : '';
            });

            document.getElementById('pay-btn').addEventListener('click', async () => {
                const btn = document.getElementById('pay-btn');
                const errorDiv = document.getElementById('card-errors');
                const original = btn.textContent;

                btn.disabled = true;
                btn.textContent = 'Processing...';
                errorDiv.textContent = '';

                try {
                    const res = await fetch('/Checkout/CreatePaymentIntent', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    });

                    const text = await res.text();
                    let data;
                    try { data = JSON.parse(text); } catch (e) { throw new Error("Server returned invalid data."); }

                    if (data.error) {
                        errorDiv.textContent = data.error;
                        btn.disabled = false;
                        btn.textContent = original;
                        return;
                    }

                    const { paymentIntent, error: stripeError } = await stripe.confirmCardPayment(
                        data.clientSecret, { payment_method: { card: cardElement } }
                    );

                    if (stripeError) {
                        errorDiv.textContent = stripeError.message;
                        btn.disabled = false;
                        btn.textContent = original;
                    } else if (paymentIntent.status === 'succeeded') {
                        const finalizeRes = await fetch('/Checkout/FinalizeOrder', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ payment_intent_id: paymentIntent.id })
                        });

                        const finalizeData = await finalizeRes.json();
                        if (!finalizeData || !finalizeData.success) {
                            errorDiv.textContent = finalizeData.message || 'Payment succeeded but failed to save order.';
                            btn.disabled = false;
                            btn.textContent = original;
                            return;
                        }

                        window.location.href = '/Checkout/Success?payment_id=' + encodeURIComponent(finalizeData.payment_id);
                    }
                } catch (err) {
                    errorDiv.textContent = err.message;
                    btn.disabled = false;
                    btn.textContent = original;
                }
            });
    </script>
</body>
</html>