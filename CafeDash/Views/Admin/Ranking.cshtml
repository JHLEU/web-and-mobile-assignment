@{
    ViewBag.Title = "Restaurant Performance Ranking";
}

<!-- Link your new CSS file -->
<link rel="stylesheet" href="~/css/admin.css">

<div class="main">
    <div class="main-navbar">
        <div class="main-title">
            <h1>Business Analytics</h1>
        </div>
        <a href="/Admin/Settings" style="text-decoration: none; color: inherit;">
            <div class="profile" style="cursor: pointer;">
                <span class="user"><ion-icon name="people-circle-outline"></ion-icon></span>
                <strong>Admin</strong>
            </div>
        </a>
    </div>

    <div id="alertBox"></div>

    <div class="main-menus">
        <div class="ranking-container">

            <div class="ranking-header">
                <div>
                    <h2>Restaurant Rankings</h2>
                    <p>Based on successful transactions and total revenue (MYR).</p>
                </div>
                <button onclick="loadRestaurantRanking()" class="save-btn">
                    <ion-icon name="refresh-outline"></ion-icon> Refresh Data
                </button>
            </div>

            <div class="charts-grid">
                <div class="chart-card">
                    <div class="chart-title">
                        <h3><ion-icon name="bar-chart-outline"></ion-icon> Restaurant Sales (MYR)</h3>
                        <p>Total revenue from successful payments, per restaurant.</p>
                    </div>
                    <div class="chart-wrapper">
                        <canvas id="salesChart" aria-label="Restaurant sales column chart" role="img"></canvas>
                    </div>
                </div>

                <div class="chart-card">
                    <div class="chart-title">
                        <h3><ion-icon name="trending-up-outline"></ion-icon> Trending Restaurants (Orders)</h3>
                        <p>Number of successful transactions per restaurant.</p>
                    </div>
                    <div class="chart-wrapper">
                        <canvas id="trendingChart" aria-label="Trending restaurants column chart" role="img"></canvas>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="ranking-table">
                    <thead>
                        <tr>
                            <th>Rank</th>
                            <th>Restaurant Name</th>
                            <th>Total Transactions</th>
                            <th>Total Revenue (RM)</th>
                        </tr>
                    </thead>
                    <tbody id="rankingBody">
                        <tr>
                            <td colspan="4" class="ranking-loading">
                                <ion-icon name="sync-outline"></ion-icon>
                                <p>Fetching latest sales data...</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script src="~/js/admin_ranking.js" asp-append-version="true"></script>